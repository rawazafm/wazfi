{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wazfi",
  "mainBinaryName": "wazfi",
  "version": "0.1.12",
  "identifier": "com.rawaz.wazfi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "wazfi — Wireless Audit Suite",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Wireless audit suite GUI for airgeddon",
    "longDescription": "wazfi is a modern desktop GUI for the airgeddon wireless auditing toolset. Run it on a Linux host with a monitor-mode-capable adapter.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
